# The public oneshot server as a systemd service, on the game box beside
# Gates (ops/README.md):
#
#   sudo cp ops/oneshot.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now oneshot
#   systemctl status oneshot ; journalctl -u oneshot -f
#
# It runs out of /home/master/oneshot-deploy, which `ci/deploy_server.sh`
# stages, never out of the checkout: a `cargo clean` or a branch switch in the
# tree must not be what the next restart finds. What it writes (replays, the
# review queue) goes to /home/master/oneshot-data.
#
# Signals (crates/server/src/main.rs):
#   - stop / restart send SIGTERM: the server DRAINS. No new players (a hello
#     is answered "full or restarting"), the queue is let go, every running
#     match plays to its end and its replay and rating report go out, then it
#     exits. `--drain-max` caps the wait; TimeoutStopSec sits above it so
#     systemd never kills a drain that is on time.
#   - reload sends SIGHUP: the certificate is read again and handed to new
#     handshakes; nobody is disconnected (the certbot hook uses this).

[Unit]
Description=oneshot server — game.elopros.com:61250
Documentation=https://github.com/AnthonE/oneshot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=master
Group=master
WorkingDirectory=/home/master/oneshot-deploy
# UDP 61250 is the game (open in ufw AND the Hetzner cloud firewall); HTTP
# 8450 is loopback only, behind the box's nginx on 443
# (ops/game-elopros-oneshot.nginx.conf). The page is on elopros.com, so a
# pass names elopros.com as its shard and the page's origin may read
# server.json and /nonce. The Elo Pros key is the platform's account key
# (GET https://elopros.com/api/account/pubkey); the server key's public half
# is entered on the dev desk under id eu-1.
ExecStart=/home/master/oneshot-deploy/oneshot-server \
  --bind 0.0.0.0:61250 \
  --http 127.0.0.1:8450 \
  --cert /home/master/oneshot-certs/fullchain.pem \
  --key /home/master/oneshot-certs/privkey.pem \
  --public-addr game.elopros.com:61250 \
  --domain elopros.com \
  --allow-origin https://elopros.com \
  --elo-pubkey aFt4QqMGWbw1aPASBd9FEUoCgdeaGKyx+MXlh0oaif8= \
  --elo-origin https://elopros.com \
  --elo-key /home/master/oneshot-data/server.pem \
  --elo-key-id eu-1 \
  --replays /home/master/oneshot-data/replays \
  --capacity 256 \
  --drain-max 900
ExecReload=/bin/kill -HUP $MAINPID

Restart=always
RestartSec=2

# SIGTERM is the drain. A ranked match is at most 12 minutes (Doubles) plus
# its end screen; 900 s covers it, and 60 s more lets the reports go out.
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=1000

LimitNOFILE=65536

ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/master/oneshot-data
PrivateTmp=true
NoNewPrivileges=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=oneshot

[Install]
WantedBy=multi-user.target
